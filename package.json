{
  "name": "brag-semanal",
  "version": "0.1.0",
  "private": true,
  "description": "MVP autoral de rascunho de brag document com evidência sintética, CLI e UI local. Sem APIs reais.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && npm run build:web",
    "build:web": "vite build --config web/vite.config.ts",
    "build:static": "VITE_STATIC_DEMO=true vite build --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --reporter=verbose",
    "cli": "tsx src/cli.ts",
    "generate": "tsx src/cli.ts generate --fixtures fixtures --out artifacts/examples/draft.md --json artifacts/examples/draft.json",
    "demo": "tsx src/cli.ts demo --port 43141 --fixtures fixtures",
    "smoke": "tsx src/cli.ts smoke --fixtures fixtures",
    "capture": "tsx scripts/capture.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^10.14.0",
    "playwright": "^1.56.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.1.12",
    "vitest": "4.1.12"
  }
}
